# ===== Kommo CRM =====
# Subdomínio da conta: se você acessa https://veroimoveis.kommo.com, o valor é "veroimoveis"
KOMMO_SUBDOMAIN=
# Token de longa duração (Kommo > Configurações > Integrações > Criar integração privada > Chaves e escopos)
KOMMO_TOKEN=
# IDs do funil e da etapa onde os leads do site devem entrar (opcional: sem eles, vai para o funil principal)
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=

# ===== Sanity (painel de imóveis e blog) =====
# Sem estas variáveis o site usa o conteúdo de exemplo em src/data/
SANITY_PROJECT_ID=
SANITY_DATASET=production
