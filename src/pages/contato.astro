---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { waLink } from '../lib/content';
---
<Base solidHeader
  title="Contato | VERO Soluções Imobiliárias – Porto Belo e Itapema"
  description="Fale com a VERO pelo WhatsApp (47) 99992-2868 ou solicite um diagnóstico imobiliário gratuito. Atendimento em Porto Belo e Itapema – SC.">
<main>
  <div class="page-hero">
    <div class="container">
      <span class="eyebrow">Contato</span>
      <h1>Vamos desenhar o seu <span class="gold-text">próximo investimento</span></h1>
      <p>Solicite um diagnóstico imobiliário gratuito ou fale direto com a gente pelo WhatsApp.</p>
    </div>
  </div>
  <section>
    <div class="container split">
      <div>
        <span class="eyebrow">Atendimento</span>
        <h2 class="section-title">Fale com um <em>especialista</em></h2>
        <ul class="check-list">
          <li><a href={waLink('Olá! Vim pelo site da VERO.')} target="_blank" rel="noopener">WhatsApp: (47) 99992-2868</a></li>
          <li><a href="mailto:verosolucoesimobiliarias@gmail.com">verosolucoesimobiliarias@gmail.com</a></li>
          <li>Porto Belo e Itapema – Santa Catarina</li>
          <li><a href="https://www.instagram.com/vero.solucoes.imob/" target="_blank" rel="noopener">Instagram @vero.solucoes.imob</a></li>
        </ul>
        <a class="btn btn-gold" href={waLink('Olá! Vim pelo site da VERO.')} target="_blank" rel="noopener">Chamar no WhatsApp</a>
      </div>
      <LeadForm origem="diagnostico-contato" variante="diagnostico" titulo="Solicitar diagnóstico" sub="Retornamos o mais rápido possível." botao="Enviar" />
    </div>
  </section>
</main>
</Base>
