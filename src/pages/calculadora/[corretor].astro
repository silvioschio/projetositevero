---
// Link pessoal de cada corretor: /calculadora/<identificador-do-corretor>/
// Fora do Google (noindex): serve só para o corretor enviar aos contatos dele.
import Base from '../../layouts/Base.astro';
import Calculadora from '../../components/Calculadora.astro';
import { getEquipe } from '../../lib/content';

export async function getStaticPaths() {
  return (await getEquipe()).map((c) => ({ params: { corretor: c.slug }, props: { corretor: c } }));
}
const { corretor } = Astro.props;
---
<Base solidHeader noindex
  title={`${corretor.nome} te convidou: Qual imóvel cabe no seu bolso? | VERO`}
  description="Informe a entrada, a parcela mensal e o reforço anual que você pode pagar e descubra quais imóveis no litoral de SC cabem no seu bolso. Simulação gratuita."
  whatsMsg={`Olá, ${corretor.nome.split(' ')[0]}! Vim pelo site da VERO.`} whatsNumero={corretor.whatsapp}>
  <Calculadora corretor={corretor} />
</Base>
