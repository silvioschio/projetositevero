---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getPosts, dataBR } from '../../lib/content';
import type { Post } from '../../lib/types';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post, posts } }));
}
const { post: p, posts } = Astro.props as { post: Post; posts: Post[] };
const outros = posts.filter((o) => o.slug !== p.slug).slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p.titulo,
  description: p.resumo,
  image: new URL(p.imagem.src, Astro.site).toString(),
  datePublished: p.data,
  author: { '@type': 'Person', name: p.autor },
  publisher: { '@type': 'Organization', name: 'VERO Soluções Imobiliárias', logo: { '@type': 'ImageObject', url: new URL('/img/logo-vero.png', Astro.site).toString() } },
  mainEntityOfPage: new URL(`/blog/${p.slug}/`, Astro.site).toString(),
};
---
<Base solidHeader title={`${p.titulo} | Blog VERO`} description={p.resumo} image={p.imagem.src} jsonLd={jsonLd}>
<main class="container">
  <article class="article">
    <nav class="breadcrumb" style="padding-top:60px" aria-label="Você está em"><a href="/">Início</a><span>/</span><a href="/blog/">Blog</a><span>/</span>{p.categoria}</nav>
    <span class="eyebrow" style="display:block;margin-top:30px">{p.categoria}</span>
    <h1 class="section-title" style="font-size:clamp(32px,4vw,48px)">{p.titulo}</h1>
    <p class="article-meta">Por {p.autor} · {dataBR(p.data)}</p>
    <div class="divider"></div>
    <div class="article-cover"><img src={p.imagem.src} alt={p.imagem.alt} width="1200" height="675"></div>
    <div class="prose" set:html={p.conteudo} />
    <div class="article-cta">
      <LeadForm origem="blog-artigo" variante="diagnostico" titulo="Quer aplicar isso no seu patrimônio?" sub="Fale com um especialista da VERO e receba um diagnóstico gratuito." botao="Quero meu diagnóstico" />
    </div>
  </article>
  {outros.length > 0 && (
    <section style="padding: 0 0 110px;">
      <span class="eyebrow">Continue lendo</span>
      <h2 class="section-title">Outros <em>artigos</em></h2>
      <div class="blog-grid" style="margin-top:30px">{outros.map((o) => <PostCard post={o} />)}</div>
    </section>
  )}
</main>
</Base>
